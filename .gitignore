node_modules/
out/
dist/
*.log
.DS_Store
.eslintcache

# Bundled tool binaries are fetched by a script, not committed (they're large).
resources/bin/*
!resources/bin/.gitkeep
# Bundled LibreOffice tree (~360 MB) — downloaded/extracted by fetch-binaries.
resources/libreoffice/
# Bundled Ghostscript tree (~42 MB) — downloaded/extracted by fetch-binaries.
resources/ghostscript/
# Bundled Real-ESRGAN tree (~47 MB, exe + dlls + models) — fetch-binaries.
resources/realesrgan/

# Local Claude settings overrides
.claude/settings.local.json
.harness/

# Python bytecode (from sidecar syntax checks)
__pycache__/
*.pyc
build/logo-mockups/

# Channel signing key — never commit. See scripts/registry-channel.mjs
channel-private.pem
channel.json

# Playwright artifacts
test-results
playwright-report
