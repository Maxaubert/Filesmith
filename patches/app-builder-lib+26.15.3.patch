+++ b/node_modules/app-builder-lib/templates/nsis/include/extractAppPackage.nsh
@@ -90,49 +90,17 @@
 !macroend
 
 !macro extractUsing7za FILE
-  Push $OUTDIR
-  CreateDirectory "$PLUGINSDIR\7z-out"
-  ClearErrors
-  SetOutPath "$PLUGINSDIR\7z-out"
+  # Filesmith patch: extract STRAIGHT into $OUTDIR ($INSTDIR).
+  #
+  # Upstream extracts into $PLUGINSDIRz-out and then copies everything to
+  # $INSTDIR with one blocking `CopyFiles /SILENT` - for a 1.4 GB payload that
+  # is a full minute of a frozen window AFTER the progress bar already hit
+  # 100% (Nsis7z pumps the bar during extraction; CopyFiles pumps nothing and
+  # snaps the bar back to instruction-based progress first). Users read that
+  # as a hang. The temp hop bought atomicity on locked files, which matters
+  # for in-place updates of a RUNNING app - but CHECK_APP_RUNNING has already
+  # closed the app and uninstallOldVersion has already emptied $INSTDIR by the
+  # time this runs, so the direct extract (upstream's own last-resort branch)
+  # is safe here and shows honest progress the whole way.
   Nsis7z::Extract "${FILE}"
-  Pop $R0
-  SetOutPath $R0
-
-  # Retry counter
-  StrCpy $R1 0
-
-  LoopExtract7za:
-    IntOp $R1 $R1 + 1
-
-    # Attempt to copy files in atomic way
-    CopyFiles /SILENT "$PLUGINSDIR\7z-out\*" $OUTDIR
-    IfErrors 0 DoneExtract7za
-
-    DetailPrint `Can't modify "${PRODUCT_NAME}"'s files.`
-    ${if} $R1 < 5
-      # Try copying a few times before asking for a user action.
-      Goto RetryExtract7za
-    ${else}
-      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(appCannotBeClosed)" /SD IDRETRY IDCANCEL AbortExtract7za
-    ${endIf}
-
-    # As an absolutely last resort after a few automatic attempts and user
-    # intervention - we will just overwrite everything with `Nsis7z::Extract`
-    # even though it is not atomic and will ignore errors.
-
-    # Clear the temporary folder first to make sure we don't use twice as
-    # much disk space.
-    RMDir /r "$PLUGINSDIR\7z-out"
-
-    Nsis7z::Extract "${FILE}"
-    Goto DoneExtract7za
-
-  AbortExtract7za:
-    Quit
-
-  RetryExtract7za:
-    Sleep 1000
-    Goto LoopExtract7za
-
-  DoneExtract7za:
 !macroend
