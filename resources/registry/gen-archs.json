      "label": "Krea 2 Turbo",
      "group": "Krea 2",
      "provenance": {
        "source": "builtin",
        "host": "huggingface.co"
      },
      "capabilities": {
        "task": "text-to-image",
        "minDim": 256,
        "maxDim": 2048,
        "dimStep": 8
      },
      "sampler": {
        "name": "euler",
        "scheduler": "simple",
        "steps": 8,
        "cfg": 1,
        "guidance": 0,
        "hasGuidance": false
      },
      "requires": {
        "nodes": [
          "CLIPTextEncode",
          "EmptySD3LatentImage",
          "KSampler",
          "VAEDecode",
          "SaveImage"
        ],
        "clipLoader": {
          "node": "CLIPLoader",
          "type": "krea2"
        },
        "minComfyNote": "Krea 2 needs an up-to-date ComfyUI (nightly, mid-2026) for the krea2 encoder type."
      },
      "companions": [
        {
          "role": "clip",
          "label": "Qwen3-VL 4B text encoder",
          "subdir": "text_encoders",
          "identify": {
            "nameHint": "qwen3vl.*4b"
          },
          "download": {
            "filename": "qwen3vl_4b_fp8_scaled.safetensors",
            "approxSize": "5.2 GB",
            "urls": [
              "https://huggingface.co/Comfy-Org/Krea-2/resolve/952f49d49653cb42e7d6cf7cbfad74738073ec7d/text_encoders/qwen3vl_4b_fp8_scaled.safetensors",
              "https://huggingface.co/Comfy-Org/Krea-2/resolve/main/text_encoders/qwen3vl_4b_fp8_scaled.safetensors"
            ],
            "sha256": "54bd5144df0bbc25dd6ccadfcb826b521445a1b06ae5a42570bdd2974ca87094",
            "bytes": 5242467968
          }
        },
        {
          "role": "vae",
          "label": "Qwen-Image VAE",
          "subdir": "vae",
          "identify": {
            "nameHint": "qwen_image_vae"
          },
          "download": {
            "filename": "qwen_image_vae.safetensors",
            "approxSize": "254 MB",
            "urls": [
              "https://huggingface.co/Comfy-Org/Krea-2/resolve/952f49d49653cb42e7d6cf7cbfad74738073ec7d/vae/qwen_image_vae.safetensors",
              "https://huggingface.co/Comfy-Org/Krea-2/resolve/main/vae/qwen_image_vae.safetensors"
            ],
            "sha256": "a70580f0213e67967ee9c95f05bb400e8fb08307e017a924bf3441223e023d1f",
            "bytes": 253806246
          }
        }
      ],
      "workflow": {
        "format": "comfy-api-v1",
        "$comment": "Krea 2 is a Qwen-Image-lineage MMDiT on a 16-channel latent — it needs EmptySD3LatentImage (16ch), NOT EmptyLatentImage (4ch, SD1.x/SDXL).",
        "template": {
          "1": {
            "class_type": "UNETLoader",
            "inputs": {
              "unet_name": "${unet}",
              "weight_dtype": "default"
            }
          },
          "2": {
            "class_type": "CLIPLoader",
            "inputs": {
              "clip_name": "${clip}",
              "type": "krea2"
            }
          },
          "3": {
            "class_type": "VAELoader",
            "inputs": {
              "vae_name": "${vae}"
            }
          },
          "4": {
            "class_type": "CLIPTextEncode",
            "inputs": {
              "text": "${prompt}",
              "clip": [
                "2",
                0
              ]
            }
          },
          "5": {
            "class_type": "CLIPTextEncode",
            "inputs": {
              "text": "${negative}",
              "clip": [
                "2",
                0
              ]
            }
          },
          "6": {
            "class_type": "EmptySD3LatentImage",
            "inputs": {
              "width": "${width}",
              "height": "${height}",
              "batch_size": "${batch}"
            }
          },
          "7": {
            "class_type": "KSampler",
            "inputs": {
              "seed": "${seed}",
              "steps": "${steps}",
              "cfg": 1,
              "sampler_name": "${sampler}",
              "scheduler": "${scheduler}",
              "denoise": 1,
              "model": [
                "1",
                0
              ],
              "positive": [
                "4",
                0
              ],
              "negative": [
                "5",
                0
              ],
              "latent_image": [
                "6",
                0
              ]
            }
          },
          "8": {
            "class_type": "VAEDecode",
            "inputs": {
              "samples": [
                "7",
                0
              ],
              "vae": [
                "3",
                0
              ]
            }
          },
          "9": {
            "class_type": "SaveImage",
            "inputs": {
              "filename_prefix": "${prefix}",
              "images": [
                "8",
                0
              ]
            }
          }
        }
      }
    }
  ]
}
