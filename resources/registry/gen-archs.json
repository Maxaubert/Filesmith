{
  "$comment": [
    "Filesmith's built-in generation-model registry (layer 1: read-only, ships in the installer).",
    "This file is DATA. Adding a new checkpoint family here — or in your own file under",
    "%APPDATA%/Filesmith/registry/user/ — requires no app release and no code change.",
    "A user entry with the same id overrides the built-in FIELD BY FIELD, so you can fix a",
    "dead download URL by supplying only { id, companions } and inherit everything else.",
    "Workflow templates are ComfyUI API-format graphs; ${name} placeholders are substituted",
    "as data (never evaluated) and the result is only ever POSTed to a loopback ComfyUI."
  ],
  "schemaVersion": 1,
  "entries": [
    {
      "id": "sdxl",
      "kind": "generate",
      "label": "SDXL / single-file checkpoint",
      "group": "Checkpoints",
      "provenance": {
        "source": "builtin"
      },
      "capabilities": {
        "task": "text-to-image",
        "minDim": 256,
        "maxDim": 2048,
        "dimStep": 8
      },
      "sampler": {
        "name": "dpmpp_2m",
        "scheduler": "karras",
        "steps": 28,
        "cfg": 7,
        "guidance": 0,
        "hasGuidance": false
      },
      "requires": {
        "nodes": [
          "CLIPTextEncode",
          "EmptyLatentImage",
          "KSampler",
          "VAEDecode",
          "SaveImage"
        ]
      },
      "checkpointWorkflow": {
        "format": "comfy-api-v1",
        "template": {
          "3": {
            "class_type": "KSampler",
            "inputs": {
              "seed": "${seed}",
              "steps": "${steps}",
              "cfg": "${cfg}",
              "sampler_name": "${sampler}",
              "scheduler": "${scheduler}",
              "denoise": 1,
              "model": [
                "4",
                0
              ],
              "positive": [
                "6",
                0
              ],
              "negative": [
                "7",
                0
              ],
              "latent_image": [
                "5",
                0
              ]
            }
          },
          "4": {
            "class_type": "CheckpointLoaderSimple",
            "inputs": {
              "ckpt_name": "${model}"
            }
          },
          "5": {
            "class_type": "EmptyLatentImage",
            "inputs": {
              "width": "${width}",
              "height": "${height}",
              "batch_size": "${batch}"
            }
          },
          "6": {
            "class_type": "CLIPTextEncode",
            "inputs": {
              "text": "${prompt}",
              "clip": [
                "4",
                1
              ]
            }
          },
          "7": {
            "class_type": "CLIPTextEncode",
            "inputs": {
              "text": "${negative}",
              "clip": [
                "4",
                1
              ]
            }
          },
          "8": {
            "class_type": "VAEDecode",
            "inputs": {
              "samples": [
                "3",
                0
              ],
              "vae": [
                "4",
                2
              ]
            }
          },
          "9": {
            "class_type": "SaveImage",
            "inputs": {
              "filename_prefix": "${prefix}",
              "images": [
                "8",
                0
              ]
            }
          }
        }
      }
    },
